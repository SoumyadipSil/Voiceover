VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only speech provider credentials. Do not prefix these with VITE_.
NVIDIA_API_KEY=your-nvidia-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_TTS_URL=https://openrouter.ai/api/v1/audio/speech

# Optional: override the NVIDIA NIM endpoint for a self-hosted deployment.
# NVIDIA_TTS_URL=https://ai.api.nvidia.com/v1/audio/speech

# Optional: shown to OpenRouter for request attribution.
# OPENROUTER_SITE_URL=http://localhost:8443
